{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wisp",
  "version": "0.1.0",
  "identifier": "com.wisp.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Capabilities for the main WhatsApp Web window AND its remote origin",
          "remote": {
            "urls": [
              "https://web.whatsapp.com"
            ]
          },
          "local": true,
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "allow-open-settings-window",
            "allow-badge-set-count"
          ]
        },
        {
          "identifier": "settings-capability",
          "description": "Capabilities for the local settings window",
          "local": true,
          "windows": [
            "settings"
          ],
          "permissions": [
            "core:default",
            "allow-settings-get",
            "allow-settings-set-autostart",
            "allow-settings-set-hotkey",
            "allow-settings-set-blur-hotkey",
            "allow-settings-set-panic-hotkey",
            "allow-settings-reset-view",
            "allow-summon-window",
            "allow-privacy-get",
            "allow-privacy-set",
            "allow-privacy-toggle-all",
            "allow-panic-toggle",
            "allow-quit-app",
            "allow-settings-set-unread-badge",
            "allow-settings-set-flash",
            "allow-settings-set-close-to-tray",
            "allow-settings-set-start-minimized"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "wisp",
          "whatsapp"
        ]
      }
    }
  }
}